datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  STUDENT
  INSTRUCTOR
  ADMIN
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  DROPPED
}

enum TargetAudience {
  K12
  HIGHER_ED
  PROFESSIONAL
}

enum DeliveryMode {
  SELF_PACED
  COHORT_BASED
  HYBRID
  IN_PERSON
}

enum CourseRequestStatus {
  PENDING_REVIEW
  APPROVED
  UNAVAILABLE
  NO_INSTRUCTOR_AVAILABLE
  PROPOSAL_SENT
  REJECTED
}

enum PrintItemType {
  SUMMARY_BOOKLET
  FULL_LECTURE_NOTES
  STUDY_GUIDE
  VERIFIED_PHYSICAL_CERTIFICATE
}

enum PrintOrderStatus {
  ORDER_RECEIVED
  PRINTING_IN_PROGRESS
  DISPATCHED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum EventType {
  SEMINAR
  WORKSHOP
  MENTOR_TALK
  CAREER_PANEL
}

enum InstructorAppStatus {
  NEW_APPLICATION
  UNDER_REVIEW
  INTERVIEW_SCHEDULED
  APPROVED
  REJECTED
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  MESSAGE
}

enum ProjectSubmissionStatus {
  PENDING_REVIEW
  PASSED
  REVISION_REQUIRED
}

enum OrgRole {
  ORG_ADMIN
  ORG_MEMBER
}

model User {
  id                  String       @id @default(uuid())
  name                String
  email               String       @unique
  passwordHash        String
  role                Role         @default(STUDENT)
  avatarUrl           String?
  bio                 String?      @db.Text
  isTemporaryPassword Boolean      @default(false)
  title               String?
  organization        String?
  academicCredentials String?
  linkedinUrl         String?
  githubUrl           String?
  websiteUrl          String?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  coursesTaught       Course[]           @relation("InstructorCourses")
  enrollments         Enrollment[]
  lessonProgress      LessonProgress[]
  quizAttempts        QuizAttempt[]
  certificates        Certificate[]
  reviews             Review[]
  comments            Comment[]
  wishlists           Wishlist[]
  printOrders         PrintOrder[]
  eventRegistrations  EventRegistration[]
  assignedCourseRequests CourseRequest[] @relation("AssignedInstructor")
  testimonials        Testimonial[]
  notifications       Notification[]
  projectSubmissions  ProjectSubmission[]
  orgMemberships      OrgMembership[]
}

model Course {
  id               String         @id @default(uuid())
  title            String
  description      String
  syllabus         String         @db.Text
  price            Float          @default(0.0)
  category         String         @default("Development")
  targetAudience   TargetAudience @default(PROFESSIONAL)
  deliveryMode     DeliveryMode   @default(SELF_PACED)
  startDate        DateTime?
  endDate          DateTime?
  durationWeeks    Int?           @default(8)
  hoursPerWeek     Int?           @default(5)
  scheduleDetails  String?
  inclusions       String[]       @default([])
  exclusions       String[]       @default([])
  prerequisites    String[]       @default([])
  gradingCriteria  String?        @db.Text
  attendancePolicy String?        @db.Text
  materialPrice    Float?         @default(29.99)
  
  instructorId     String
  instructor       User           @relation("InstructorCourses", fields: [instructorId], references: [id])
  
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  enrollments      Enrollment[]
  modules          Module[]
  certificates     Certificate[]
  reviews          Review[]
  wishlists        Wishlist[]
  printOrders      PrintOrder[]
  testimonials     Testimonial[]
  projectSubmissions ProjectSubmission[]
}

model Review {
  id        String   @id @default(uuid())
  rating    Int      @default(5)
  comment   String   @db.Text
  
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id])
  
  createdAt DateTime @default(now())

  @@unique([userId, courseId])
}

model Wishlist {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, courseId])
}

model Enrollment {
  id        String           @id @default(uuid())
  studentId String
  student   User             @relation(fields: [studentId], references: [id])
  courseId  String
  course    Course           @relation(fields: [courseId], references: [id])
  status    EnrollmentStatus @default(ACTIVE)
  createdAt DateTime         @default(now())
  
  @@unique([studentId, courseId])
}

model Module {
  id       String   @id @default(uuid())
  title    String
  order    Int      @default(0)
  courseId String
  course   Course   @relation(fields: [courseId], references: [id])
  
  lessons  Lesson[]
  quizzes  Quiz[]
}

model Lesson {
  id       String   @id @default(uuid())
  title    String
  content  String   @db.Text
  order    Int      @default(0)
  moduleId String
  module   Module   @relation(fields: [moduleId], references: [id])
  
  progress LessonProgress[]
  comments Comment[]
}

model Comment {
  id          String    @id @default(uuid())
  text        String    @db.Text
  lessonId    String
  lesson      Lesson    @relation(fields: [lessonId], references: [id])
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  
  // Q&A Forum Extension (Phase 1)
  parentId    String?
  parent      Comment?  @relation("ThreadedReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies     Comment[] @relation("ThreadedReplies")
  upvotes     Int       @default(0)
  isEndorsed  Boolean   @default(false)
  
  createdAt   DateTime  @default(now())
}

model LessonProgress {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  lessonId  String
  lesson    Lesson   @relation(fields: [lessonId], references: [id])
  completed Boolean  @default(false)
  
  @@unique([userId, lessonId])
}

model Quiz {
  id        String     @id @default(uuid())
  title     String
  moduleId  String
  module    Module     @relation(fields: [moduleId], references: [id])
  
  questions Question[]
  attempts  QuizAttempt[]
}

model Question {
  id      String   @id @default(uuid())
  text    String
  quizId  String
  quiz    Quiz     @relation(fields: [quizId], references: [id])
  
  options Option[]
}

model Option {
  id         String   @id @default(uuid())
  text       String
  isCorrect  Boolean  @default(false)
  questionId String
  question   Question @relation(fields: [questionId], references: [id])
}

model QuizAttempt {
  id      String  @id @default(uuid())
  userId  String
  user    User    @relation(fields: [userId], references: [id])
  quizId  String
  quiz    Quiz    @relation(fields: [quizId], references: [id])
  score   Float
  passed  Boolean @default(false)
}

model Certificate {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id])
  issueDate DateTime @default(now())
  pdfUrl    String?
  
  @@unique([userId, courseId])
}

model CourseRequest {
  id                    String              @id @default(uuid())
  requesterName         String
  email                 String
  phone                 String?
  organization          String?
  targetAudience        TargetAudience      @default(PROFESSIONAL)
  topic                 String
  studentCount          Int                 @default(10)
  neededTimeframe       String              
  deliveryMode          DeliveryMode        @default(HYBRID)
  specificRequirements  String?             @db.Text
  status                CourseRequestStatus @default(PENDING_REVIEW)
  adminNotes            String?             @db.Text
  
  assignedInstructorId  String?
  assignedInstructor    User?               @relation("AssignedInstructor", fields: [assignedInstructorId], references: [id])
  
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
}

model PrintOrder {
  id             String           @id @default(uuid())
  userId         String
  user           User             @relation(fields: [userId], references: [id])
  courseId       String?
  course         Course?          @relation(fields: [courseId], references: [id])
  itemType       PrintItemType    @default(SUMMARY_BOOKLET)
  quantity       Int              @default(1)
  recipientName  String
  phone          String
  addressLine1   String
  addressLine2   String?
  city           String
  state          String
  postalCode     String
  country        String           @default("USA")
  totalAmount    Float            @default(19.99)
  paymentStatus  String           @default("PAID")
  status         PrintOrderStatus @default(ORDER_RECEIVED)
  trackingNumber String?
  carrier        String?          
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
}

model Event {
  id             String              @id @default(uuid())
  title          String
  description    String              @db.Text
  speakerName    String
  speakerTitle   String
  speakerAvatar  String?
  speakerBio     String?             @db.Text
  eventType      EventType           @default(SEMINAR)
  targetAudience TargetAudience      @default(PROFESSIONAL)
  startTime      DateTime
  endTime        DateTime
  isVirtual      Boolean             @default(true)
  locationOrUrl  String?             
  maxCapacity    Int                 @default(100)
  bannerUrl      String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  registrations  EventRegistration[]
}

model EventRegistration {
  id            String   @id @default(uuid())
  eventId       String
  event         Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId        String?
  user          User?    @relation(fields: [userId], references: [id])
  attendeeName  String
  attendeeEmail String
  organization  String?
  attended      Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@unique([eventId, attendeeEmail])
}

model InstructorApplication {
  id                    String              @id @default(uuid())
  fullName              String
  email                 String
  phone                 String
  currentAffiliation    String              
  highestDegree         String              
  linkedinUrl           String?
  portfolioUrl          String?
  resumeUrl             String?
  courseProposalTitle   String
  courseProposalSummary String              @db.Text
  sampleVideoUrl        String?
  targetAudience        TargetAudience      @default(PROFESSIONAL)
  status                InstructorAppStatus @default(NEW_APPLICATION)
  reviewNotes           String?             @db.Text
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
}

model Testimonial {
  id              String   @id @default(uuid())
  studentName     String
  studentRole     String   
  companyOrSchool String   
  avatarUrl       String?
  quote           String   @db.Text
  rating          Int      @default(5)
  isFeatured      Boolean  @default(true)
  
  userId          String?
  user            User?    @relation(fields: [userId], references: [id])
  courseId        String?
  course          Course?  @relation(fields: [courseId], references: [id])
  certificateId   String?
  createdAt       DateTime @default(now())
}

// ==========================================
// Phase 1-4 Expansion Models
// ==========================================

// Phase 1: In-App Notifications
model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String           @db.Text
  type      NotificationType @default(INFO)
  read      Boolean          @default(false)
  link      String?          
  createdAt DateTime         @default(now())
}

// Phase 2: Capstone Project Submissions
model ProjectSubmission {
  id           String                  @id @default(uuid())
  courseId     String
  course       Course                  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  userId       String
  user         User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  repoUrl      String?                 // GitHub, GitLab, etc.
  documentUrl  String?                 // PDF deliverable
  notes        String?                 @db.Text
  status       ProjectSubmissionStatus @default(PENDING_REVIEW)
  feedback     String?                 @db.Text
  gradedAt     DateTime?
  createdAt    DateTime                @default(now())
}

// Phase 3: Promotional Coupons
model Coupon {
  id             String    @id @default(uuid())
  code           String    @unique
  discountPercent Int?     // e.g., 50 for 50%
  discountAmount Float?    // e.g., 20.00 for $20 off
  maxUses        Int?      // Null = unlimited
  uses           Int       @default(0)
  expiresAt      DateTime? 
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
}

// Phase 4: Enterprise B2B Organizations
model Organization {
  id           String          @id @default(uuid())
  name         String
  contactEmail String
  seatLimit    Int             @default(0)
  activeSeats  Int             @default(0)
  joinCode     String?         @unique // Custom code for auto-joining
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  members      OrgMembership[]
}

model OrgMembership {
  id        String       @id @default(uuid())
  orgId     String
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      OrgRole      @default(ORG_MEMBER)
  joinedAt  DateTime     @default(now())

  @@unique([orgId, userId])
}
